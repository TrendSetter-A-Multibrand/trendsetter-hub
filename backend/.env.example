# Заглушки. Реальные значения — только в окружении сервера, не в репозитории.

# Подключение приложения (пользователь hub_app, без прав на изменение структуры).
# На DO: хост из Connection details, порт 25060, sslmode=require.
HUB_DATABASE_URL=postgresql+psycopg://hub_app:CHANGE_ME@HOST:25060/defaultdb?sslmode=require

# Подключение для миграций (doadmin). Нужно только при деплое, приложению не передаётся.
HUB_MIGRATION_DATABASE_URL=postgresql+psycopg://doadmin:CHANGE_ME@HOST:25060/defaultdb?sslmode=require

# Длинная случайная строка (минимум 32 символа)
HUB_JWT_SECRET=CHANGE_ME
HUB_JWT_TTL_MINUTES=720

# ПИН ответственного склада (доп. секции, импорт старых коробов). Только в окружении сервера. Не задан — эти действия отключены.
HUB_WAREHOUSE_PIN=CHANGE_ME
# Часовой пояс для времён в ответах и выгрузках
HUB_TIMEZONE=Asia/Yerevan

# Адреса фронтенда через запятую (CORS)
HUB_CORS_ORIGINS=http://localhost:5173
# Или шаблон адресов (например превью Vercel): регулярное выражение, необязательно
# HUB_CORS_ORIGIN_REGEX=^https://trendsetter-hab-git-.*-trendsetter1\.vercel\.app$
